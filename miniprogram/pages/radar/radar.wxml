<view class="page-shell">
  <view class="hero">
    <view>
      <text class="eyebrow">PREMIER WATCH</text>
      <text class="title">CS2 Radar</text>
      <text class="subtitle">共享监控 · 官方 Steam 数据</text>
    </view>
    <view class="pulse {{scanning || session ? 'active' : ''}}"><view class="pulse-dot"></view></view>
  </view>

  <view class="control-card">
    <view class="scan-state">
      <view>
        <text class="state-label">{{session ? '持续扫描中' : (scanning ? '正在获取实时快照' : '待命')}}</text>
        <text class="state-meta">更新 {{lastUpdated || '--:--:--'}} · {{targets.length}} 个目标</text>
      </view>
      <text wx:if="{{remainingText}}" class="countdown">{{remainingText}}</text>
    </view>
    <view class="button-row">
      <button class="primary-button" bindtap="startContinuousScan" loading="{{scanning}}" disabled="{{!!session}}">{{session ? '已开启' : '扫描 10 分钟'}}</button>
      <button class="icon-button" bindtap="toggleAddPanel">＋ 添加</button>
      <button class="icon-button" bindtap="scanWebLogin">扫码登录</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>

  <view wx:if="{{showAddPanel}}" class="editor-card">
    <view class="section-heading"><text>添加监控对象</text><text class="close" bindtap="toggleAddPanel">×</text></view>
    <view class="resolve-row">
      <input class="text-input grow" value="{{resolveValue}}" bindinput="onResolveInput" placeholder="SteamID 或个人资料链接" />
      <button class="small-button" bindtap="resolveTarget">解析</button>
      <button class="small-button ghost" bindtap="readClipboard">剪贴板</button>
    </view>
    <view wx:if="{{preview}}" class="preview">
      <image class="avatar large" src="{{preview.avatar_url}}" mode="aspectFill" />
      <view class="preview-copy"><text class="player-name">{{preview.personaname}}</text><text class="mono">{{preview.steam_id}}</text></view>
    </view>
    <view wx:if="{{preview}}" class="form-grid">
      <input class="text-input" data-field="alias" value="{{addDraft.alias}}" bindinput="updateAddField" placeholder="备注名" />
      <input class="text-input" data-field="tags" value="{{addDraft.tags}}" bindinput="updateAddField" placeholder="标签，用逗号分隔" />
      <input class="text-input" type="number" data-field="manual_cs_level" value="{{addDraft.manual_cs_level}}" bindinput="updateAddField" placeholder="人工 CS 等级" />
      <picker range="{{medalOptions}}" bindchange="updateAddMedal"><view class="picker">服役勋章：{{addDraft.service_medal}}</view></picker>
      <input class="text-input full" data-field="note" value="{{addDraft.note}}" bindinput="updateAddField" placeholder="补充说明" />
      <button class="primary-button full" bindtap="confirmAdd">确认加入共享 Radar</button>
    </view>
  </view>

  <scroll-view class="tag-strip" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="tag-row">
      <text class="filter-chip {{selectedTag === '' ? 'selected' : ''}}" data-tag="" bindtap="selectTag">全部</text>
      <text wx:for="{{tags}}" wx:key="*this" class="filter-chip {{selectedTag === item ? 'selected' : ''}}" data-tag="{{item}}" bindtap="selectTag">{{item}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && groups.length === 0}}" class="empty-state">
    <text class="empty-title">Radar 暂时是空的</text>
    <text class="empty-copy">从 Steam 个人资料复制链接，然后点击“添加”。</text>
  </view>

  <view wx:for="{{groups}}" wx:key="status" class="status-group">
    <view class="group-heading"><view class="status-mark {{item.tone}}"></view><text>{{item.label}}</text><text class="group-count">{{item.items.length}}</text></view>
    <view wx:for="{{item.items}}" wx:for-item="target" wx:key="id" class="target-card">
      <view class="target-main">
        <image class="avatar" src="{{target.avatar_url}}" mode="aspectFill" />
        <view class="target-copy">
          <view class="name-row"><text class="player-name">{{target.displayName}}</text><text class="status-pill {{target.statusTone}}">{{target.statusLabel}}</text></view>
          <text class="game-line">{{target.game_extra_info || '未公开具体游戏状态'}}</text>
          <view class="signal-row">
            <text wx:if="{{target.sameMatchCount > 1}}" class="signal danger">疑似同局 ×{{target.sameMatchCount}}</text>
            <text wx:if="{{target.manual_cs_level != null && target.manual_cs_level < 40}}" class="signal danger">CS Lv.{{target.manual_cs_level}}</text>
            <text wx:for="{{target.tags}}" wx:key="*this" class="signal">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="metrics">
        <view><text class="metric-value">{{target.playtimeHours}}</text><text class="metric-label">CS2 小时</text></view>
        <view><text class="metric-value risk {{target.risk_signals.length ? 'hot' : ''}}">{{target.risk_signals.length}}</text><text class="metric-label">风险信号</text></view>
        <view><text class="metric-value small">{{target.observedText}}</text><text class="metric-label">最近观测</text></view>
      </view>
      <view class="card-actions"><text data-id="{{target.id}}" bindtap="beginEdit">编辑标注</text><text class="remove" data-id="{{target.id}}" bindtap="removeTarget">移除</text></view>

      <view wx:if="{{editingId === target.id}}" class="inline-editor">
        <input class="text-input" data-field="alias" value="{{editDraft.alias}}" bindinput="updateEditField" placeholder="备注名" />
        <input class="text-input" data-field="tags" value="{{editDraft.tags}}" bindinput="updateEditField" placeholder="标签" />
        <input class="text-input" type="number" data-field="manual_cs_level" value="{{editDraft.manual_cs_level}}" bindinput="updateEditField" placeholder="CS 等级" />
        <picker range="{{medalOptions}}" bindchange="updateEditMedal"><view class="picker">服役勋章：{{editDraft.service_medal}}</view></picker>
        <input class="text-input full" data-field="note" value="{{editDraft.note}}" bindinput="updateEditField" placeholder="说明" />
        <view class="button-row full"><button class="small-button" bindtap="saveEdit">保存</button><button class="small-button ghost" bindtap="cancelEdit">取消</button></view>
      </view>
    </view>
  </view>

  <view class="disclaimer">Radar 仅展示官方 Steam 可见状态与人工标注。“疑似同局”不代表组排，未知资料不代表安全或作弊。</view>
</view>
