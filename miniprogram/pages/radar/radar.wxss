page { background: #151719; color: #f4f1ea; min-height: 100%; }
.page-shell { padding: 36rpx 28rpx 180rpx; }
.hero { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 8rpx 36rpx; }
.eyebrow { display: block; color: #d99a3d; letter-spacing: 5rpx; font-size: 20rpx; font-weight: 700; }
.title { display: block; font-size: 60rpx; line-height: 1.1; font-weight: 800; margin-top: 8rpx; }
.subtitle { display: block; color: #8d9297; font-size: 24rpx; margin-top: 12rpx; }
.pulse { width: 64rpx; height: 64rpx; border: 2rpx solid #3b4045; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.pulse.active { border-color: rgba(217,154,61,.45); box-shadow: 0 0 0 12rpx rgba(217,154,61,.06); }
.pulse-dot { width: 14rpx; height: 14rpx; background: #596067; border-radius: 50%; }
.pulse.active .pulse-dot { background: #d99a3d; box-shadow: 0 0 18rpx #d99a3d; }
.control-card, .editor-card, .target-card { background: #202326; border: 1rpx solid #30353a; border-radius: 22rpx; }
.control-card { padding: 28rpx; }
.scan-state { display: flex; justify-content: space-between; align-items: center; }
.state-label { display: block; font-size: 30rpx; font-weight: 700; }
.state-meta { display: block; color: #858b91; font-size: 22rpx; margin-top: 8rpx; }
.countdown { font-family: monospace; font-size: 38rpx; color: #d99a3d; }
.button-row { display: flex; gap: 14rpx; margin-top: 24rpx; }
button { margin: 0; }
.primary-button { background: #d99a3d; color: #151719; border-radius: 12rpx; font-size: 25rpx; font-weight: 800; line-height: 74rpx; flex: 1; }
.primary-button[disabled] { background: #4b4438; color: #a89a82; }
.icon-button, .small-button { background: #2c3034; color: #e9e6df; border: 1rpx solid #41464b; border-radius: 12rpx; font-size: 24rpx; line-height: 70rpx; padding: 0 22rpx; }
.small-button { line-height: 64rpx; }
.small-button.ghost { color: #aeb3b8; background: transparent; }
.error-banner { background: rgba(202,78,64,.14); border: 1rpx solid rgba(202,78,64,.45); color: #ef9b91; padding: 20rpx 24rpx; border-radius: 14rpx; margin-top: 20rpx; font-size: 24rpx; }
.editor-card { margin-top: 22rpx; padding: 26rpx; }
.section-heading { font-size: 29rpx; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 22rpx; }
.close { color: #92989e; font-size: 38rpx; }
.resolve-row { display: flex; gap: 10rpx; }
.grow { flex: 1; }
.text-input, .picker { background: #17191b; border: 1rpx solid #34393e; border-radius: 10rpx; color: #f4f1ea; padding: 0 20rpx; height: 68rpx; font-size: 24rpx; box-sizing: border-box; }
.picker { line-height: 68rpx; color: #aeb3b8; }
.preview { display: flex; align-items: center; gap: 20rpx; margin: 24rpx 0; padding: 20rpx; background: #191c1e; border-radius: 14rpx; }
.preview-copy { min-width: 0; }
.mono { display: block; color: #81888e; font-family: monospace; font-size: 22rpx; margin-top: 5rpx; }
.form-grid, .inline-editor { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.full { grid-column: 1 / -1; }
.tag-strip { margin: 28rpx -28rpx 12rpx; width: calc(100% + 56rpx); white-space: nowrap; }
.tag-row { display: inline-flex; gap: 12rpx; padding: 0 28rpx; }
.filter-chip { display: inline-block; padding: 14rpx 24rpx; border: 1rpx solid #353a3f; border-radius: 100rpx; color: #8f969c; font-size: 23rpx; }
.filter-chip.selected { color: #17191b; background: #d99a3d; border-color: #d99a3d; font-weight: 700; }
.status-group { margin-top: 30rpx; }
.group-heading { display: flex; align-items: center; gap: 12rpx; color: #c4c6c6; font-size: 25rpx; font-weight: 700; padding: 0 8rpx 14rpx; }
.status-mark { width: 12rpx; height: 12rpx; border-radius: 50%; background: #777; }
.status-mark.danger { background: #d05c4d; box-shadow: 0 0 12rpx rgba(208,92,77,.5); }
.status-mark.warning { background: #d99a3d; }
.status-mark.online { background: #75a775; }
.group-count { margin-left: auto; color: #6f767c; }
.target-card { padding: 24rpx; margin-bottom: 16rpx; }
.target-main { display: flex; gap: 20rpx; }
.avatar { width: 78rpx; height: 78rpx; border-radius: 14rpx; background: #303438; flex-shrink: 0; }
.avatar.large { width: 92rpx; height: 92rpx; }
.target-copy { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 12rpx; }
.player-name { font-size: 29rpx; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-pill { flex-shrink: 0; padding: 5rpx 11rpx; border-radius: 7rpx; background: #33383c; color: #aeb3b8; font-size: 19rpx; }
.status-pill.danger { color: #ef8d81; background: rgba(208,92,77,.14); }
.status-pill.warning { color: #e8ae59; background: rgba(217,154,61,.12); }
.status-pill.online { color: #91bd91; background: rgba(117,167,117,.12); }
.game-line { display: block; color: #858c92; font-size: 22rpx; margin-top: 9rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.signal-row { display: flex; flex-wrap: wrap; gap: 7rpx; margin-top: 12rpx; }
.signal { color: #989fa5; background: #292d30; border-radius: 6rpx; padding: 4rpx 9rpx; font-size: 18rpx; }
.signal.danger { color: #ef968b; background: rgba(208,92,77,.13); }
.metrics { border-top: 1rpx solid #30353a; margin-top: 22rpx; padding-top: 18rpx; display: grid; grid-template-columns: 1fr 1fr 1.25fr; }
.metrics > view { display: flex; flex-direction: column; }
.metric-value { font-size: 28rpx; font-weight: 750; }
.metric-value.small { font-family: monospace; font-size: 23rpx; }
.metric-value.hot { color: #e07062; }
.metric-label { color: #737a80; font-size: 18rpx; margin-top: 4rpx; }
.card-actions { display: flex; gap: 28rpx; color: #d99a3d; font-size: 21rpx; margin-top: 20rpx; }
.card-actions .remove { color: #9d7470; }
.inline-editor { border-top: 1rpx solid #33383c; margin-top: 20rpx; padding-top: 20rpx; }
.empty-state { padding: 100rpx 30rpx; text-align: center; }
.empty-title { display: block; font-size: 32rpx; font-weight: 700; }
.empty-copy { display: block; color: #7e858b; font-size: 24rpx; margin-top: 12rpx; }
.disclaimer { color: #666d73; font-size: 20rpx; line-height: 1.6; margin: 44rpx 10rpx 0; text-align: center; }
