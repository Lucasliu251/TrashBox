BIND=127.0.0.1
DOMAIN=
RADAR_BASE_PATH=/radar
SNIPER_BASE_PATH=/game/sniper
SNIPER_PORT=8003
MUSIC_PORT=8004
BACKEND_PORT=2026
# BACKEND_DIR=/home/ubuntu/TrashBox-Server/Backend
# MUSIC_DIR=/home/ubuntu/KBot/MusicBot
# MUSIC_PYTHON=/home/ubuntu/KBot/MusicBot/venv/bin/python
# TRASHBOX_LOGIN_URL=https://trashbox.tech/login
# 生产身份平台的提供方密钥写在 Backend/.env，Music 机器人密钥留在 MusicBot/.env。
# Mac 本地端口可通过 LOCAL_AUTH_PORT=5175 / LOCAL_MUSIC_PORT=8004 等环境变量覆盖。
